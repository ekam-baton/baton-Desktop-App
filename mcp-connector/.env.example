# ============================================================
# Baton MCP Connector — Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit the real .env to source control.
# ============================================================

# ── Server ────────────────────────────────────────────────
MCP_PORT=8081

# ── Security: JWT (REQUIRED — no defaults) ────────────────
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_HEX_CHARS

# Must be different from JWT_SECRET. Generate with:
#   openssl rand -hex 32
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_64_HEX_CHARS

JWT_EXPIRY_HOURS=24

# ── Security: Database (REQUIRED — no defaults) ───────────
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/baton

# ── Security: Admin Dashboard ─────────────────────────────
# If not set, a random password is generated and saved to baton_admin_password.txt
# Set explicitly for reproducible deployments:
# ADMIN_PASSWORD=your_strong_admin_password_here

# ── Security: Metrics Endpoint ────────────────────────────
# If not set, /metrics is completely blocked (403 Forbidden).
# Set to enable Prometheus scraping:
# METRICS_TOKEN=your_strong_metrics_bearer_token

# ── Rate Limiting ─────────────────────────────────────────
# Global requests per minute (across all authenticated endpoints)
RATE_LIMIT_RPM=60
# Max pairing attempts per minute (unauthenticated endpoint — keep tight)
PAIR_RATE_LIMIT_PER_MIN=5

# ── A2A Router ────────────────────────────────────────────
# ALWAYS use wss:// in production to prevent MITM attacks.
A2A_ROUTER_URL=wss://your-a2a-router-host:8080

# ── TLS (Recommended) ─────────────────────────────────────
# For production, use a TLS reverse proxy (Caddy, nginx) and set:
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem

# ── MCP Agents ────────────────────────────────────────────
# Register your local agent(s) here. The connector will spawn them as stdio processes.
# Supports quoted paths with spaces (uses shell-words parsing).
#
# MCP_AGENT_OPENCLAW_CMD=node
# MCP_AGENT_OPENCLAW_ARGS=/path/to/openclaw/index.js --config "/path with spaces/config.json"
#
# MCP_AGENT_MYAGENT_CMD=python3
# MCP_AGENT_MYAGENT_ARGS=/home/user/my-agent/main.py

# ── LLM Providers (all optional) ─────────────────────────
# NVIDIA_API_KEY=nvapi-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# OLLAMA_BASE_URL=http://localhost:11434

# DEFAULT_PROVIDER=Nvidianim

# ── Logging ───────────────────────────────────────────────
# LOG_FORMAT=json   # Use 'json' for structured log aggregation (e.g. Loki, CloudWatch)
# LOG_FORMAT=pretty # Default: human-readable colored output
