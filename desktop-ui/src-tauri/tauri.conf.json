{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baton",
  "version": "0.3.0",
  "identifier": "com.ekam.baton",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Baton",
        "label": "main",
        "width": 1000,
        "height": 700,
        "visible": false
      },
      {
        "title": "",
        "label": "splashscreen",
        "url": "/splash.html",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libssl3",
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}